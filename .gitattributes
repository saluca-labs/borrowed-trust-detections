# Detection content is consumed by parsers on Linux sensors and in CI. Pin LF so a
# Windows checkout does not ship CRLF into a Suricata or Sigma pipeline.
* text=auto eol=lf

# PowerShell is run on Windows, where CRLF is the native convention.
*.ps1 text eol=crlf

*.yar   text eol=lf
*.yml   text eol=lf
*.rules text eol=lf
*.kql   text eol=lf
*.spl   text eol=lf
*.csv   text eol=lf
*.py    text eol=lf
*.cff   text eol=lf
*.md    text eol=lf
